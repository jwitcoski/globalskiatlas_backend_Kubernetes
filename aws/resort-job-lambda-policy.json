{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:298043721974:log-group:/aws/lambda/globalskiatlas-resort-job:*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::globalskiatlas-backend-k8s-output",
        "arn:aws:s3:::globalskiatlas-backend-k8s-output/*"
      ]
    }
  ]
}
