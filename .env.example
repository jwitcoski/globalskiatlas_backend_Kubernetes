# Optional: copy to .env if you use a docker-compose that reads it.
# Regional pipelines (docker-compose.<region>.yml) download Geofabrik PBF and run locally.

# Example if you add a region that uses Overpass or a custom PBF URL:
# OVERPASS_REGION=region-name
# OVERPASS_PLANET_URL=https://download.geofabrik.de/region-latest.osm.pbf

# One-resort / nightly Overpass fallback (docker-compose.nightly.yml, one-resort.yml):
# MAPLARK_API_KEY=your_maplark_key
# MAPLARK_URL=https://api.maplark.com/api/interpreter
# MAPLARK_MAX_AROUND_M=16000
